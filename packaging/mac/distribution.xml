<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>ClaudeTune 1.0</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="vst3" title="VST3 plug-in" description="Installs ClaudeTune.vst3 into /Library/Audio/Plug-Ins/VST3">
        <pkg-ref id="com.claudetune.ClaudeTune.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (Logic, GarageBand)" description="Installs ClaudeTune.component into /Library/Audio/Plug-Ins/Components">
        <pkg-ref id="com.claudetune.ClaudeTune.au"/>
    </choice>
    <choice id="app" title="Standalone app" description="Installs ClaudeTune.app into /Applications for testing with a microphone">
        <pkg-ref id="com.claudetune.ClaudeTune.app"/>
    </choice>

    <pkg-ref id="com.claudetune.ClaudeTune.vst3" version="1.0.0" onConclusion="none">ClaudeTune-VST3.pkg</pkg-ref>
    <pkg-ref id="com.claudetune.ClaudeTune.au" version="1.0.0" onConclusion="none">ClaudeTune-AU.pkg</pkg-ref>
    <pkg-ref id="com.claudetune.ClaudeTune.app" version="1.0.0" onConclusion="none">ClaudeTune-App.pkg</pkg-ref>
</installer-gui-script>
